## Ported from Build/Libraries/LibWeb/CSS/PropertyID.cpp Web::CSS::property_accepts_integer.
pub func property_accepts_integer(property_id: PropertyId, value: i64) -> bool:
    match property_id:
        .column_count: return value >= 1
        .counter_increment: return true
        .counter_reset: return true
        .counter_set: return true
        .font_feature_settings: return value >= 0
        .math_depth: return true
        .order: return true
        .orphans: return value >= 1
        .widows: return value >= 1
        .z_index: return true
        _: return false

