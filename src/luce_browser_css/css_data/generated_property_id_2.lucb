pub func resolve_legacy_value_alias(property_id: PropertyId, keyword: Keyword) -> Keyword?:
    match property_id:
        .overflow:
            match keyword:
                .overlay: return Keyword.auto
                _: return none
        .overflow_block:
            match keyword:
                .overlay: return Keyword.auto
                _: return none
        .overflow_inline:
            match keyword:
                .overlay: return Keyword.auto
                _: return none
        .overflow_x:
            match keyword:
                .overlay: return Keyword.auto
                _: return none
        .overflow_y:
            match keyword:
                .overlay: return Keyword.auto
                _: return none
        .text_justify:
            match keyword:
                .distribute: return Keyword.inter_character
                _: return none
        _: return none

