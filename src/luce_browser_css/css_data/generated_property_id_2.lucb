pub func property_accepts_number(property_id: PropertyId, value: f64) -> bool:
    match property_id:
        .animation_iteration_count: return value >= 0.0
        .border_image_outset: return value >= 0.0
        .border_image_slice: return value >= 0.0
        .border_image_width: return value >= 0.0
        .cursor: return true
        .flex_grow: return value >= 0.0
        .flex_shrink: return value >= 0.0
        .font_variation_settings: return true
        .font_weight: return value >= 1.0 and value <= 1000.0
        .line_height: return value >= 0.0
        .stroke_dashoffset: return value >= 0.0
        .stroke_miterlimit: return value >= 0.0
        .stroke_width: return value >= 0.0
        .tab_size: return value >= 0.0
        _: return false

