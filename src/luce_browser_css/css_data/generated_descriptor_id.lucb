                    ak.vector_append_t(&metadata.syntax, KeywordOrPropertyIdOrDescriptorMetadataValueType.keyword(value = Keyword.words))
                    ak.vector_append_t(&metadata.syntax, KeywordOrPropertyIdOrDescriptorMetadataValueType.keyword(value = Keyword.spell_out))
                    ak.vector_append_t(&metadata.syntax, KeywordOrPropertyIdOrDescriptorMetadataValueType.descriptor_metadata_value_type(value = DescriptorMetadataValueType.counter_style_name))
                    metadata.allow_arbitrary_substitution_functions = false
                    return metadata
                _: trap("VERIFY_NOT_REACHED")
        .function:
            match descriptor_id:
                .result:
                    var metadata = DescriptorMetadata()
                    ak.vector_append_t(&metadata.syntax, KeywordOrPropertyIdOrDescriptorMetadataValueType.descriptor_metadata_value_type(value = DescriptorMetadataValueType.optional_declaration_value))
                    metadata.allow_arbitrary_substitution_functions = true
                    return metadata
                .custom:
                    var metadata = DescriptorMetadata()
                    ak.vector_append_t(&metadata.syntax, KeywordOrPropertyIdOrDescriptorMetadataValueType.descriptor_metadata_value_type(value = DescriptorMetadataValueType.optional_declaration_value))
                    metadata.allow_arbitrary_substitution_functions = true
                    return metadata
                _: trap("VERIFY_NOT_REACHED")
        _: trap("VERIFY_NOT_REACHED")
