        .grid:
            return false
        .height:
            return false
        .horizontal_viewport_segments:
            return false
        .hover:
            match keyword:
                .none_: return true
                .hover: return true
                _: return false
        .inverted_colors:
            match keyword:
                .none_: return true
                .inverted: return true
                _: return false
        .monochrome:
            return false
        .nav_controls:
            match keyword:
                .none_: return true
                .back: return true
                _: return false
        .orientation:
            match keyword:
                .portrait: return true
                .landscape: return true
                _: return false
        .overflow_block:
            match keyword:
                .none_: return true
                .scroll: return true
                .paged: return true
                _: return false
        .overflow_inline:
            match keyword:
                .none_: return true
                .scroll: return true
                _: return false
        .pointer:
            match keyword:
                .none_: return true
                .coarse: return true
                .fine: return true
                _: return false
        .prefers_color_scheme:
            match keyword:
                .light: return true
