# mark: Keyword.h ===============================================================================

## Ported from Build/Libraries/LibWeb/CSS/Keyword.h Web::CSS::is_css_wide_keyword.
# https://www.w3.org/TR/css-values-4/#common-keywords
# https://drafts.csswg.org/css-cascade-4/#valdef-all-revert
pub func is_css_wide_keyword(name: ak.StringView) -> bool:
    return (ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("inherit"))
        or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("initial"))
        or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("revert"))
        or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("revert-layer"))
        or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("unset")))

# mark: Keyword.cpp =============================================================================

# HashMap<StringView, Keyword, AK::CaseInsensitiveASCIIStringViewTraits> g_stringview_to_keyword_map:
# a C++ global built before main, here built on first use (the module var of a static).
var g_stringview_to_keyword_map: ak.HashMap[ak.StringView, Keyword, ak.CaseInsensitiveAsciiStringViewTraits]
var g_stringview_to_keyword_map_initialized: bool

# The keyword table, built on first use in the C heap: it holds views of string literals and
# lives as long as the program, as the C++ global does.
func stringview_to_keyword_map() -> const ak.HashMap[ak.StringView, Keyword, ak.CaseInsensitiveAsciiStringViewTraits]*:
    if g_stringview_to_keyword_map_initialized:
        return &g_stringview_to_keyword_map
