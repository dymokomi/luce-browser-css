## Ported from Build/Libraries/LibWeb/CSS/Keyword.cpp Web::CSS::keyword_from_string.
pub func keyword_from_string(string: ak.StringView) -> Keyword?:
    let keyword = ak.hash_map_get_k_const(stringview_to_keyword_map(), string) else return none
    return *keyword

