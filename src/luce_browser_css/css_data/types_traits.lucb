#==============================================================================================
#
#   types_traits - hash traits of the key types of HashMap/HashTable instantiations
#
#   DESCRIPTION:
#       Generated by the skeleton generator (DESIGN.md §2.6): one declaration per distinct
#       instantiation the phase-1 declarations use, at donor commit 47c82b38d0. The bodies are
#       filled in by hand (region r12c): AK::Traits<Enum> (AK/Traits.h:77) hashes the underlying
#       integer with Traits<UnderlyingType>::hash, which is u32_hash for types under 8 bytes, and
#       compares with ==.
#
#==============================================================================================

## AK::Traits<PropertyId>: AK's hash and equality for the key type.
pub struct PropertyIdTraits: ak.Traits[PropertyId]:
    var empty_: u8

    func hash_of(key: const PropertyId*) -> u32: return ak.u32_hash((u32)(u16)*key)

    func equals(a: const PropertyId*, b: const PropertyId*) -> bool: return *a == *b

## AK::Traits<PseudoClass>: AK's hash and equality for the key type.
pub struct PseudoClassTraits: ak.Traits[PseudoClass]:
    var empty_: u8

    func hash_of(key: const PseudoClass*) -> u32: return ak.u32_hash((u32)(i32)*key)

    func equals(a: const PseudoClass*, b: const PseudoClass*) -> bool: return *a == *b

## AK::Traits<PseudoElement>: AK's hash and equality for the key type.
pub struct PseudoElementTraits: ak.Traits[PseudoElement]:
    var empty_: u8

    func hash_of(key: const PseudoElement*) -> u32: return ak.u32_hash((u32)(u8)*key)

    func equals(a: const PseudoElement*, b: const PseudoElement*) -> bool: return *a == *b
