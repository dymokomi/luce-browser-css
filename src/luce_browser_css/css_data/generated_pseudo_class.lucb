                parameter_type = PseudoClassMetadataParameterType.none_,
                is_valid_as_function = false,
                is_valid_as_identifier = true,
            )
        .target:
            return PseudoClassMetadata(
                parameter_type = PseudoClassMetadataParameterType.none_,
                is_valid_as_function = false,
                is_valid_as_identifier = true,
            )
        .unchecked:
            return PseudoClassMetadata(
