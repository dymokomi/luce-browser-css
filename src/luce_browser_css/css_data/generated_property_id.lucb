## Ported from Build/Libraries/LibWeb/CSS/PropertyID.cpp Web::CSS::property_id_from_camel_case_string.
pub func property_id_from_camel_case_string(string: ak.StringView) -> PropertyId?:
    let property_id = ak.hash_map_get_k_const(generate_camel_case_property_table(), string) else return none
    return *property_id

## Ported from Build/Libraries/LibWeb/CSS/PropertyID.cpp Web::CSS::property_id_from_string.
pub func property_id_from_string(string: ak.StringView) -> PropertyId?:
    if is_a_custom_property_name_string(string):
        return PropertyId.custom

    let property_id = ak.hash_map_get_k_const(generate_properties_table(), string) else return none
    return *property_id

