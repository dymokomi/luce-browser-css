#==============================================================================================
#
#   token - CSS::Parser::Token: the tokens of CSS Syntax Level 3
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Parser/Token.h (lines 1-216) and LibWeb/CSS/Parser/Token.cpp (lines
#       1-427), in the header's order with the .cpp bodies in place of their declarations.
#       The Formatter<Token> specialization is token_to_string. `create*`'s C++ default
#       `String original_source_text = {}` is written by the caller as `ak.string_new()`.
#
#==============================================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Token.h:17 Web::CSS::Parser::clamp_to_single_precision.
func clamp_to_single_precision(value: f64) -> f64:
    if value > (f64)ak.f32_max:
        return (f64)ak.f32_max

    if value < (f64)ak.f32_lowest:
        return (f64)ak.f32_lowest

    return value

# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Token.cpp:14 Web::CSS::Parser::Token::create.
## Use this only to create types that don't have their own create_foo() methods below.
pub func token_create(type_: TokenType, original_source_text: ak.String) -> Token:
    assert(type_ == TokenType.invalid or type_ == TokenType.end_of_file or type_ == TokenType.bad_string or type_ == TokenType.bad_url or type_ == TokenType.cdo or type_ == TokenType.cdc or type_ == TokenType.colon or type_ == TokenType.semicolon or type_ == TokenType.comma or type_ == TokenType.open_square or type_ == TokenType.close_square or type_ == TokenType.open_paren or type_ == TokenType.close_paren or type_ == TokenType.open_curly or type_ == TokenType.close_curly)

    var token = token_new()
    token.m_type = type_
    token.m_original_source_text = original_source_text
    return token

