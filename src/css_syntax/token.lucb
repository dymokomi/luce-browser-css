# mark: Brackets ================================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Token.cpp:346 Web::CSS::Parser::Token::mirror_variant.
pub func token_mirror_variant(this: const Token*) -> TokenType:
    if token_is(this, TokenType.open_curly):
        return TokenType.close_curly

    if token_is(this, TokenType.open_square):
        return TokenType.close_square

    if token_is(this, TokenType.open_paren):
        return TokenType.close_paren

    return TokenType.invalid

## Ported from Libraries/LibWeb/CSS/Parser/Token.cpp:363 Web::CSS::Parser::Token::bracket_string.
pub func token_bracket_string(this: const Token*) -> ak.StringView:
    if token_is(this, TokenType.open_curly):
        return ak.sv("{")

    if token_is(this, TokenType.close_curly):
        return ak.sv("}")

    if token_is(this, TokenType.open_square):
        return ak.sv("[")

    if token_is(this, TokenType.close_square):
        return ak.sv("]")

    if token_is(this, TokenType.open_paren):
        return ak.sv("(")

    if token_is(this, TokenType.close_paren):
        return ak.sv(")")

    return ak.sv("")

## Ported from Libraries/LibWeb/CSS/Parser/Token.cpp:392 Web::CSS::Parser::Token::bracket_mirror_string.
pub func token_bracket_mirror_string(this: const Token*) -> ak.StringView:
    if token_is(this, TokenType.open_curly):
        return ak.sv("}")

    if token_is(this, TokenType.close_curly):
        return ak.sv("{")

    if token_is(this, TokenType.open_square):
        return ak.sv("]")

    if token_is(this, TokenType.close_square):
        return ak.sv("[")

    if token_is(this, TokenType.open_paren):
        return ak.sv(")")

    if token_is(this, TokenType.close_paren):
        return ak.sv("(")

    return ak.sv("")

# mark: Serialization ===========================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Token.cpp:139 Web::CSS::Parser::Token::to_string.
pub func token_to_string(this: const Token*) -> ak.String:
    match this.m_type:
        .end_of_file:
            return ak.string_new()
        .ident:
            let ident = token_ident(this)
            return serialize_an_identifier_string_view(ak.fly_string_bytes_as_string_view(&ident))
        .function:
            let function = token_function(this)
            let serialized = serialize_an_identifier_string_view(ak.fly_string_bytes_as_string_view(&function))
            return string_formatted("{}(", [ak.arg_string_view(ak.string_bytes_as_string_view(&serialized))])
        .at_keyword:
            let at_keyword = token_at_keyword(this)
            let serialized = serialize_an_identifier_string_view(ak.fly_string_bytes_as_string_view(&at_keyword))
            return string_formatted("@{}", [ak.arg_string_view(ak.string_bytes_as_string_view(&serialized))])
        .hash_:
            let hash_value = token_hash_value(this)
            match this.m_hash_type:
                .id:
                    let serialized = serialize_an_identifier_string_view(ak.fly_string_bytes_as_string_view(&hash_value))
                    return string_formatted("#{}", [ak.arg_string_view(ak.string_bytes_as_string_view(&serialized))])
                .unrestricted:
                    return string_formatted("#{}", [ak.arg_string_view(ak.fly_string_bytes_as_string_view(&hash_value))])
                _:
                    trap("VERIFY_NOT_REACHED")
        .string:
            let string = token_string(this)
            return serialize_a_string_string_view(ak.fly_string_bytes_as_string_view(&string))
        .bad_string:
            return ak.string_new()
        .url:
            let url = token_url(this)
            return serialize_a_url_string_view(ak.fly_string_bytes_as_string_view(&url))
        .bad_url:
            return ak.string_from_str("url()")
        .delim:
            return ak.fly_string_to_string_const(&this.m_value)
        .number:
            return ak.string_number_f64(number_value(&this.m_number_value))
        .percentage:
            return string_formatted("{}%", [ak.arg_f64(number_value(&this.m_number_value))])
        .dimension:
            let unit_ = token_dimension_unit(this)
            return string_formatted("{}{}", [ak.arg_f64(number_value(&this.m_number_value)), ak.arg_string_view(ak.fly_string_bytes_as_string_view(&unit_))])
        .whitespace:
            return ak.string_from_str(" ")
        .cdo:
            return ak.string_from_str("<!--")
        .cdc:
            return ak.string_from_str("-->")
        .colon:
            return ak.string_from_str(":")
        .semicolon:
            return ak.string_from_str(";")
        .comma:
            return ak.string_from_str(",")
        .open_square:
            return ak.string_from_str("[")
        .close_square:
            return ak.string_from_str("]")
        .open_paren:
            return ak.string_from_str("(")
        .close_paren:
            return ak.string_from_str(")")
        .open_curly:
            return ak.string_from_str("{")
        .close_curly:
            return ak.string_from_str("}")
        _:
            # Type::Invalid and anything else.
            trap("VERIFY_NOT_REACHED")

## Token::to_debug_string's `append_quoted_string` lambda.
func token_to_debug_string_append_quoted_string(builder: ak.StringBuilder*, string: ak.StringView):
    ak.string_builder_append_u8(builder, '"')
    ak.string_builder_append_escaped_for_json(builder, string)
    ak.string_builder_append_u8(builder, '"')

## Token::to_debug_string's `hash_type_name` lambda.
func token_to_debug_string_hash_type_name(hash_type: TokenHashType) -> ak.StringView:
    match hash_type:
        .id:
            return ak.sv("Id")
        .unrestricted:
            return ak.sv("Unrestricted")
        _:
            trap("VERIFY_NOT_REACHED")

## Token::to_debug_string's `number_type_name` lambda.
func token_to_debug_string_number_type_name(type_: NumberType) -> ak.StringView:
    match type_:
        .number:
            return ak.sv("Number")
        .integer_with_explicit_sign:
            return ak.sv("IntegerWithExplicitSign")
        .integer:
            return ak.sv("Integer")
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Parser/Token.cpp:207 Web::CSS::Parser::Token::to_debug_string.
pub func token_to_debug_string(this: const Token*) -> ak.String:
    var builder = ak.string_builder_new()
    var has_type_specific_fields = false
    match this.m_type:
        .invalid:
            trap("VERIFY_NOT_REACHED")

        .end_of_file:
            ak.string_builder_append_string_view(&builder, ak.sv("__EOF__("))
        .ident:
            ak.string_builder_append_string_view(&builder, ak.sv("Ident(value="))
            let ident = token_ident(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&ident))
            has_type_specific_fields = true
        .function:
            ak.string_builder_append_string_view(&builder, ak.sv("Function(value="))
            let function = token_function(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&function))
            has_type_specific_fields = true
        .at_keyword:
            ak.string_builder_append_string_view(&builder, ak.sv("AtKeyword(value="))
            let at_keyword = token_at_keyword(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&at_keyword))
            has_type_specific_fields = true
        .hash_:
            ak.string_builder_append_string_view(&builder, ak.sv("Hash(value="))
            let hash_value = token_hash_value(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&hash_value))
            string_builder_appendff(&builder, ", hash_type={}", [ak.arg_string_view(token_to_debug_string_hash_type_name(this.m_hash_type))])
            has_type_specific_fields = true
        .string:
            ak.string_builder_append_string_view(&builder, ak.sv("String(value="))
            let string = token_string(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&string))
            has_type_specific_fields = true
        .bad_string:
            ak.string_builder_append_string_view(&builder, ak.sv("BadString("))
        .url:
            ak.string_builder_append_string_view(&builder, ak.sv("Url(value="))
            let url = token_url(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&url))
            has_type_specific_fields = true
        .bad_url:
            ak.string_builder_append_string_view(&builder, ak.sv("BadUrl("))
        .delim:
            ak.string_builder_append_string_view(&builder, ak.sv("Delim(value="))
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&this.m_value))
            string_builder_appendff(&builder, ", code_point=U+{:04X}", [ak.arg_u64((u64)token_delim(this))])
            has_type_specific_fields = true
        .number:
            string_builder_appendff(&builder, "Number(value={}, number_type={}", [ak.arg_f64(token_number_value(this)), ak.arg_string_view(token_to_debug_string_number_type_name(number_type(&this.m_number_value)))])
            has_type_specific_fields = true
        .percentage:
            string_builder_appendff(&builder, "Percentage(value={}, number_type={}", [ak.arg_f64(token_percentage(this)), ak.arg_string_view(token_to_debug_string_number_type_name(number_type(&this.m_number_value)))])
            has_type_specific_fields = true
        .dimension:
            string_builder_appendff(&builder, "Dimension(value={}, number_type={}, unit=", [ak.arg_f64(token_dimension_value(this)), ak.arg_string_view(token_to_debug_string_number_type_name(number_type(&this.m_number_value)))])
            let dimension_unit = token_dimension_unit(this)
            token_to_debug_string_append_quoted_string(&builder, ak.fly_string_bytes_as_string_view(&dimension_unit))
            has_type_specific_fields = true
        .whitespace:
            ak.string_builder_append_string_view(&builder, ak.sv("Whitespace("))
        .cdo:
            ak.string_builder_append_string_view(&builder, ak.sv("CDO("))
        .cdc:
            ak.string_builder_append_string_view(&builder, ak.sv("CDC("))
        .colon:
            ak.string_builder_append_string_view(&builder, ak.sv("Colon("))
        .semicolon:
            ak.string_builder_append_string_view(&builder, ak.sv("Semicolon("))
        .comma:
            ak.string_builder_append_string_view(&builder, ak.sv("Comma("))
        .open_square:
            ak.string_builder_append_string_view(&builder, ak.sv("OpenSquare("))
        .close_square:
            ak.string_builder_append_string_view(&builder, ak.sv("CloseSquare("))
        .open_paren:
            ak.string_builder_append_string_view(&builder, ak.sv("OpenParen("))
        .close_paren:
            ak.string_builder_append_string_view(&builder, ak.sv("CloseParen("))
        .open_curly:
            ak.string_builder_append_string_view(&builder, ak.sv("OpenCurly("))
        .close_curly:
            ak.string_builder_append_string_view(&builder, ak.sv("CloseCurly("))
        _:
            # Not a Token::Type (the C++ switch has no default).
            trap("VERIFY_NOT_REACHED")

    ak.string_builder_append_string_view(&builder, ak.sv(", source=") if has_type_specific_fields else ak.sv("source="))
    token_to_debug_string_append_quoted_string(&builder, ak.string_bytes_as_string_view(&this.m_original_source_text))
    string_builder_appendff(&builder, ", start={}:{}, end={}:{})", [ak.arg_u64((u64)this.m_start_position.line), ak.arg_u64((u64)this.m_start_position.column), ak.arg_u64((u64)this.m_end_position.line), ak.arg_u64((u64)this.m_end_position.column)])
    return ak.string_builder_to_string_without_validation(&builder)

