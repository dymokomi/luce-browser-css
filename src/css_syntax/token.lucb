## Ported from Libraries/LibWeb/CSS/Parser/Token.h:191 Web::CSS::Parser::Token::operator==.
pub func token_eq(this: const Token*, other: Token) -> bool:
    return this.m_type == other.m_type and ak.fly_string_eq_fly_string(&this.m_value, &other.m_value) and number_eq(&this.m_number_value, other.m_number_value) and this.m_hash_type == other.m_hash_type
