#==============================================================================================
#
#   tokenizer_1 - CSS::Parser::Tokenizer: input, code point access, escapes, idents, numbers
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Parser/Tokenizer.h (lines 1-108: U32Twin, U32Triplet) and
#       LibWeb/CSS/Parser/Tokenizer.cpp (lines 1-576: the code point classes, tokenize, the
#       code point reading helpers, consume_escaped_code_point, consume_an_ident_like_token,
#       consume_a_number, convert_a_string_to_a_number, consume_an_ident_sequence). The rest of
#       Tokenizer.cpp is tokenizer_2.
#
#       The Tokenizer keeps a Utf8View of its own m_decoded_input, whose bytes live inside the
#       Tokenizer for a short string: a Tokenizer is constructed in place and never moved.
#
#==============================================================================================

# U+FFFD REPLACEMENT CHARACTER (�)
let replacement_character: u32 = 0xfffd

## AK/Debug.h's CSS_TOKENIZER_DEBUG (0 in the donor's build).
let css_tokenizer_debug: bool = false

# mark: U32Twin and U32Triplet ==================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Tokenizer.h:22 Web::CSS::Parser::U32Twin::set.
pub func u32_twin_set(this: U32Twin*, index: usize, value: u32):
    if index == 0:
        this.first = value
    if index == 1:
        this.second = value

## Ported from Libraries/LibWeb/CSS/Parser/Tokenizer.h:36 Web::CSS::Parser::U32Triplet::set.
pub func u32_triplet_set(this: U32Triplet*, index: usize, value: u32):
    if index == 0:
        this.first = value
    if index == 1:
        this.second = value
    if index == 2:
        this.third = value

## Ported from Libraries/LibWeb/CSS/Parser/Tokenizer.h:46 Web::CSS::Parser::U32Triplet::to_twin_12.
pub func u32_triplet_to_twin_12(this: const U32Triplet*) -> U32Twin:
    return U32Twin(first = this.first, second = this.second)

## Ported from Libraries/LibWeb/CSS/Parser/Tokenizer.h:51 Web::CSS::Parser::U32Triplet::to_twin_23.
pub func u32_triplet_to_twin_23(this: const U32Triplet*) -> U32Twin:
    return U32Twin(first = this.second, second = this.third)

