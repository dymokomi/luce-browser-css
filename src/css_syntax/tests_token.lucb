#==============================================================================================
#
#   tests_token - Token, Number and serialization, pinned to the donor
#
#   DESCRIPTION:
#       The donor has no unit test for these files, so the expected values come from a local
#       probe program built against the reference Ladybird (Token::to_debug_string,
#       Token::to_string, Number::to_string, round_to_nearest_integer, and the
#       identifier/string/URL serialization through Token::to_string). The probe itself is
#       not in the repository; its outputs are the tables at the end of this fragment.
#
#==============================================================================================

# mark: Helpers =================================================================================

## `text` as a String.
func test_string(text: str) -> ak.String:
    return ak.string_from_str(text)

## Whether `string` holds exactly `text`.
func string_is(string: const ak.String*, text: str) -> bool:
    return ak.string_view_text(ak.string_bytes_as_string_view(string)) == text

## Asserts `string` holds `text`, printing both when it does not.
func expect_string(string: const ak.String*, text: str):
    if not string_is(string, text):
        print(f"expected: {text}")
        print(f"actual:   {ak.string_view_text(ak.string_bytes_as_string_view(string))}")
        assert(false, "string mismatch")

## Tokenizes `input` and checks `to_debug_string|to_string` of every token against `expected`.
func check_token_strings(input: str, expected: const str[]):
    let tokens = tokenizer_tokenize_string_view(ak.sv(input), ak.sv("utf-8"))
    let span = ak.vector_span_const(&tokens)
    assert(span.length == expected.length, "token count")
    for index in 0..<span.length:
        var builder = ak.string_builder_new()
        let debug_string = token_to_debug_string(&span[index])
        string_builder_append_string(&builder, &debug_string)
        ak.string_builder_append_u8(&builder, '|')
        let string = token_to_string(&span[index])
        string_builder_append_string(&builder, &string)
        let line = ak.string_builder_to_string_without_validation(&builder)
        expect_string(&line, expected[index])

# mark: Tests ===================================================================================

noinline func test_token_to_string_1():
    check_token_strings(to_string_input_1, to_string_expected_1)

