noinline func test_number_serialization():
    let values = number_serialization_values()
    for index in 0..<values.length:
        let value = values[index]
        var builder = ak.string_builder_new()
        let kinds: NumberType[3] = [NumberType.number, NumberType.integer, NumberType.integer_with_explicit_sign]
        for kind in kinds:
            let number = number_create(kind, value)
            let string = number_to_string(&number)
            string_builder_append_string(&builder, &string)
            ak.string_builder_append_u8(&builder, '|')
        let number_token = token_create_number(number_create(NumberType.number, value), ak.string_new())
        let number_string = token_to_string(&number_token)
        string_builder_append_string(&builder, &number_string)
        ak.string_builder_append_u8(&builder, '|')
        let percentage_token = token_create_percentage(number_create(NumberType.number, value), ak.string_new())
        let percentage_string = token_to_string(&percentage_token)
        string_builder_append_string(&builder, &percentage_string)
        let line = ak.string_builder_to_string_without_validation(&builder)
        expect_string(&line, number_serialization_expected[index])

    let specials: Number[4] = [
        number_create(NumberType.number, math.infinity),
        number_create(NumberType.number, -math.infinity),
        number_create(NumberType.number, math.nan),
        number_create(NumberType.integer_with_explicit_sign, math.infinity),
    ]
    for index in 0..<specials.length:
        let string = number_to_string(&specials[index])
        expect_string(&string, number_special_expected[index])

test "Number::to_string and serialize_a_number":
    # Interned FlyStrings outlive the per-test allocator (docs/regions/r02.md), so the
    # test allocates from the process heap.
    test_number_serialization()

noinline func test_round_to_nearest_integer():
    let values: f64[10] = [0.5, -0.5, 1.5, -1.5, 2.4999, 1e10, -1e10, math.nan, math.infinity, -math.infinity]
    for index in 0..<values.length:
        assert(round_to_nearest_integer(values[index]) == round_expected[index])

test "round_to_nearest_integer":
    # Interned FlyStrings outlive the per-test allocator (docs/regions/r02.md), so the
    # test allocates from the process heap.
    test_round_to_nearest_integer()

noinline func test_number_arithmetic():
    let two = number_create(NumberType.integer, 2.0)
    let three = number_create(NumberType.integer_with_explicit_sign, 3.0)
    let half = number_create(NumberType.number, 0.5)
    let sum = number_add(&two, three)
    assert(number_type(&sum) == NumberType.integer and number_value(&sum) == 5.0)
    let difference = number_sub(&two, half)
    assert(number_type(&difference) == NumberType.number and number_value(&difference) == 1.5)
    let product = number_mul(&two, three)
    assert(number_type(&product) == NumberType.integer and number_value(&product) == 6.0)
    # Division is always a Number, even of two integers.
    let quotient = number_div(&three, two)
    assert(number_type(&quotient) == NumberType.number and number_value(&quotient) == 1.5)
    assert(number_is_integer(&three) and number_is_integer_with_explicit_sign(&three))
    assert(not number_is_integer(&half))
    let two_and_a_half = number_create(NumberType.number, 2.5)
    assert(number_integer_value(&two_and_a_half) == 3)
    assert(number_eq(&two, number_create(NumberType.integer, 2.0)))
    assert(not number_eq(&two, number_create(NumberType.number, 2.0)))
    assert(number_cmp(&two, three) == -1 and number_cmp(&three, two) == 1 and number_cmp(&two, number_create(NumberType.number, 2.0)) == 0)
    var zero = number_create(NumberType.integer, 7.0)
    number_construct(&zero)
    assert(number_type(&zero) == NumberType.number and number_value(&zero) == 0.0)

test "Number arithmetic, comparison and integer conversion":
    # Interned FlyStrings outlive the per-test allocator (docs/regions/r02.md), so the
    # test allocates from the process heap.
    test_number_arithmetic()

noinline func test_identifier_serialization():
    for index in 0..<serialization_names.length:
        let name = ak.fly_string_from_str(serialization_names[index])
        let tokens: Token[6] = [
            token_create_ident(name, ak.string_new()),
            token_create_string(name, ak.string_new()),
            token_create_url(name, ak.string_new()),
            token_create_function(name, ak.string_new()),
            token_create_at_keyword(name, ak.string_new()),
            token_create_hash(name, TokenHashType.id, ak.string_new()),
        ]
        var builder = ak.string_builder_new()
        for token_index in 0..<tokens.length:
            if token_index > 0:
                ak.string_builder_append_u8(&builder, ' ')
            ak.string_builder_append_u8(&builder, '[')
            let string = token_to_string(&tokens[token_index])
            string_builder_append_string(&builder, &string)
            ak.string_builder_append_u8(&builder, ']')
        let line = ak.string_builder_to_string_without_validation(&builder)
        expect_string(&line, serialization_expected[index])

    # The String forms of the serializers answer what the builder forms append.
    let identifier = serialize_an_identifier_string_view(ak.sv("-1a"))
    expect_string(&identifier, "-\\31 a")
    let string = serialize_a_string_string_view(ak.sv("a\"b"))
    expect_string(&string, "\"a\\\"b\"")
    let url = serialize_a_url_string_view(ak.sv("x"))
    expect_string(&url, "url(\"x\")")
    let number = serialize_a_number_f64(1.0 / 3.0)
    expect_string(&number, "0.333333")

test "serialize an identifier, a string and a URL":
    # Interned FlyStrings outlive the per-test allocator (docs/regions/r02.md), so the
    # test allocates from the process heap.
    test_identifier_serialization()

noinline func test_token_accessors():
    let dimension = token_create_dimension_f64(1e40, ak.fly_string_from_str("px"), test_string("1e40px"))
    # Token values are clamped to single precision when read.
    assert(token_dimension_value(&dimension) == (f64)ak.f32_max)
    assert(token_dimension_value_int(&dimension) == ak.i32_max)
    assert(not token_is_integer(&dimension))
    let negative = token_create_number(number_create(NumberType.integer, -1e40), ak.string_new())
    assert(token_number_value(&negative) == (f64)ak.f32_lowest)
    assert(token_to_integer(&negative) == ak.i32_min)
    let delim = token_create_delim(0x2f, ak.string_new())
    assert(token_delim(&delim) == 0x2f)
    let open = token_create(TokenType.open_square, ak.string_new())
    assert(token_mirror_variant(&open) == TokenType.close_square)
    assert(ak.string_view_text(token_bracket_string(&open)) == "[")
    assert(ak.string_view_text(token_bracket_mirror_string(&open)) == "]")
    let ident = token_create_ident(ak.fly_string_from_str("a"), ak.string_new())
    assert(token_mirror_variant(&ident) == TokenType.invalid)
    assert(ak.string_view_text(token_bracket_string(&ident)) == "")
    # operator== ignores the source text and positions.
    var other = token_create_ident(ak.fly_string_from_str("a"), test_string("a"))
    token_set_position_range(&other, TokenPosition(line = 1, column = 2), TokenPosition(line = 1, column = 3))
    assert(token_eq(&ident, other))
    let start = token_start_position(&other)
    let end = token_end_position(&other)
    assert(start.column == 2 and end.column == 3)
    assert(not token_eq(&ident, token_create_ident(ak.fly_string_from_str("b"), ak.string_new())))
    assert(not token_eq(&ident, token_create_function(ak.fly_string_from_str("a"), ak.string_new())))
    let hash_token = token_create_hash(ak.fly_string_from_str("x"), TokenHashType.unrestricted, ak.string_new())
    assert(token_hash_type(&hash_token) == TokenHashType.unrestricted)
    let default_token = token_new()
    assert(token_type(&default_token) == TokenType.invalid and token_hash_type_raw(&default_token) == TokenHashType.unrestricted)
    let eof = tokenizer_create_eof_token()
    assert(token_is(&eof, TokenType.end_of_file))
    let eof_source = token_original_source_text(&eof)
    expect_string(&eof_source, "")

## The token's hash type without Token::hash_type's VERIFY (for the default token).
func token_hash_type_raw(token: const Token*) -> TokenHashType:
    return token.m_hash_type

test "Token accessors, clamping, brackets and equality":
    # Interned FlyStrings outlive the per-test allocator (docs/regions/r02.md), so the
    # test allocates from the process heap.
    test_token_accessors()

