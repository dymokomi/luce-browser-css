pub func aliased_pseudo_element_from_string(string: ak.StringView) -> PseudoElement?:
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-moz-meter-bar")):
        return PseudoElement.slider_fill
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-moz-placeholder")):
        return PseudoElement.placeholder
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-moz-progress-bar")):
        return PseudoElement.slider_fill
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-moz-range-progress")):
        return PseudoElement.slider_fill
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-moz-range-track")):
        return PseudoElement.slider_track
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-moz-range-thumb")):
        return PseudoElement.slider_thumb
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-webkit-input-placeholder")):
        return PseudoElement.placeholder
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-webkit-meter-bar")):
        return PseudoElement.slider_track
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-webkit-progress-bar")):
        return PseudoElement.slider_track
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-webkit-progress-value")):
        return PseudoElement.slider_fill
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-webkit-slider-runnable-track")):
        return PseudoElement.slider_track
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("-webkit-slider-thumb")):
        return PseudoElement.slider_thumb
    return none

