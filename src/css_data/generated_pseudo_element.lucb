## Ported from Build/Libraries/LibWeb/CSS/PseudoElement.cpp Web::CSS::is_tree_abiding_pseudo_element.
pub func is_tree_abiding_pseudo_element(pseudo_element: PseudoElement) -> bool:
    # Element-backed pseudo-elements are always tree-abiding.
    # https://drafts.csswg.org/css-pseudo-4/#element-backed
    if is_element_backed_pseudo_element(pseudo_element):
        return true

    match pseudo_element:
        .after: return true
        .before: return true
        .marker: return true
        .placeholder: return true
        _: return false

## Ported from Build/Libraries/LibWeb/CSS/PseudoElement.cpp Web::CSS::is_element_backed_pseudo_element.
