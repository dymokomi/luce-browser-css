## Ported from Build/Libraries/LibWeb/CSS/PropertyID.cpp Web::CSS::map_logical_alias_to_physical_property.
pub func map_logical_alias_to_physical_property(property_id: PropertyId, mapping_context: LogicalAliasMappingContext) -> PropertyId:
    # https://drafts.csswg.org/css-writing-modes-4/#logical-to-physical
    # FIXME: Note: The used direction depends on the computed writing-mode and text-orientation: in vertical writing
    #              modes, a text-orientation value of upright forces the used direction to ltr.
    let used_direction = mapping_context.direction
    match property_id:
        .block_size:
            if mapping_context.writing_mode == WritingMode.horizontal_tb:
                return PropertyId.height
            return PropertyId.width
        .border_block_end_color:
            if mapping_context.writing_mode == WritingMode.horizontal_tb:
                return PropertyId.border_bottom_color
            if mapping_context.writing_mode == WritingMode.vertical_rl or mapping_context.writing_mode == WritingMode.sideways_rl:
                return PropertyId.border_left_color
            return PropertyId.border_right_color
        .border_block_end_style:
            if mapping_context.writing_mode == WritingMode.horizontal_tb:
                return PropertyId.border_bottom_style
            if mapping_context.writing_mode == WritingMode.vertical_rl or mapping_context.writing_mode == WritingMode.sideways_rl:
                return PropertyId.border_left_style
            return PropertyId.border_right_style
        .border_block_end_width:
            if mapping_context.writing_mode == WritingMode.horizontal_tb:
                return PropertyId.border_bottom_width
            if mapping_context.writing_mode == WritingMode.vertical_rl or mapping_context.writing_mode == WritingMode.sideways_rl:
                return PropertyId.border_left_width
            return PropertyId.border_right_width
        .border_block_start_color:
