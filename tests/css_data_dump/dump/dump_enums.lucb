## The number of EnvironmentVariable values.
let environment_variable_count: u64 = 15
## The number of MediaFeatureID values.
let media_feature_count: u64 = 37
## The number of PseudoClass values before __Count.
let pseudo_class_count: u64 = 65
## The number of PseudoElement values before KnownPseudoElementCount.
let pseudo_element_count: u64 = 20
## The number of TransformFunction values.
let transform_function_count: u64 = 21
## The number of LengthUnit values.
let length_unit_count: u64 = 43

## The physical properties of the logical property groups, group by group.
let physical_properties: css_data.PropertyId[44] = [
    css_data.PropertyId.border_top_color,
    css_data.PropertyId.border_right_color,
    css_data.PropertyId.border_bottom_color,
    css_data.PropertyId.border_left_color,
    css_data.PropertyId.border_top_left_radius,
    css_data.PropertyId.border_bottom_left_radius,
    css_data.PropertyId.border_top_right_radius,
    css_data.PropertyId.border_bottom_right_radius,
    css_data.PropertyId.border_top_style,
    css_data.PropertyId.border_right_style,
    css_data.PropertyId.border_bottom_style,
    css_data.PropertyId.border_left_style,
    css_data.PropertyId.border_top_width,
    css_data.PropertyId.border_right_width,
    css_data.PropertyId.border_bottom_width,
    css_data.PropertyId.border_left_width,
    css_data.PropertyId.corner_top_left_shape,
    css_data.PropertyId.corner_bottom_left_shape,
    css_data.PropertyId.corner_top_right_shape,
    css_data.PropertyId.corner_bottom_right_shape,
    css_data.PropertyId.top,
    css_data.PropertyId.right,
    css_data.PropertyId.bottom,
    css_data.PropertyId.left,
    css_data.PropertyId.margin_top,
    css_data.PropertyId.margin_right,
    css_data.PropertyId.margin_bottom,
    css_data.PropertyId.margin_left,
    css_data.PropertyId.max_width,
    css_data.PropertyId.max_height,
    css_data.PropertyId.min_width,
    css_data.PropertyId.min_height,
    css_data.PropertyId.overflow_x,
    css_data.PropertyId.overflow_y,
    css_data.PropertyId.overflow_clip_margin_top,
    css_data.PropertyId.overflow_clip_margin_right,
    css_data.PropertyId.overflow_clip_margin_bottom,
    css_data.PropertyId.overflow_clip_margin_left,
    css_data.PropertyId.padding_top,
    css_data.PropertyId.padding_right,
    css_data.PropertyId.padding_bottom,
    css_data.PropertyId.padding_left,
    css_data.PropertyId.width,
    css_data.PropertyId.height,
]

## The units part of the dump: for each dimension, the canonical unit, the unit names, and
## which units are compatible, with their ratios.
func dump_units(out: Out*) -> !:
    try dump_unit[css_data.AngleUnit](out, "angle", 4, (value: u64) => (css_data.AngleUnit)(u8)value, (value: css_data.AngleUnit) => (u64)(u8)value, css_data.canonical_angle_unit,
                                      css_data.to_string_angle_unit, css_data.units_are_compatible_angle_unit, css_data.ratio_between_units_angle_unit)
    try dump_unit[css_data.FlexUnit](out, "flex", 1, (value: u64) => (css_data.FlexUnit)(u8)value, (value: css_data.FlexUnit) => (u64)(u8)value, css_data.canonical_flex_unit,
                                     css_data.to_string_flex_unit, css_data.units_are_compatible_flex_unit, css_data.ratio_between_units_flex_unit)
    try dump_unit[css_data.FrequencyUnit](out, "frequency", 2, (value: u64) => (css_data.FrequencyUnit)(u8)value, (value: css_data.FrequencyUnit) => (u64)(u8)value, css_data.canonical_frequency_unit,
                                          css_data.to_string_frequency_unit, css_data.units_are_compatible_frequency_unit, css_data.ratio_between_units_frequency_unit)
    try dump_unit[css_data.LengthUnit](out, "length", 43, (value: u64) => (css_data.LengthUnit)(u8)value, (value: css_data.LengthUnit) => (u64)(u8)value, css_data.canonical_length_unit,
                                       css_data.to_string_length_unit, css_data.units_are_compatible_length_unit, css_data.ratio_between_units_length_unit)
    try dump_unit[css_data.ResolutionUnit](out, "resolution", 4, (value: u64) => (css_data.ResolutionUnit)(u8)value, (value: css_data.ResolutionUnit) => (u64)(u8)value, css_data.canonical_resolution_unit,
                                           css_data.to_string_resolution_unit, css_data.units_are_compatible_resolution_unit, css_data.ratio_between_units_resolution_unit)
    try dump_unit[css_data.TimeUnit](out, "time", 2, (value: u64) => (css_data.TimeUnit)(u8)value, (value: css_data.TimeUnit) => (u64)(u8)value, css_data.canonical_time_unit,
                                     css_data.to_string_time_unit, css_data.units_are_compatible_time_unit, css_data.ratio_between_units_time_unit)
    for value in 0..<length_unit_count:
        let unit_ = (css_data.LengthUnit)(u8)value
        try out.p(f"len {value} ")
        try out.b(css_data.is_absolute(unit_))
        try out.b(css_data.is_font_relative(unit_))
        try out.b(css_data.is_viewport_relative(unit_))
        try out.b(css_data.is_relative(unit_))
        try out.p("\n")
