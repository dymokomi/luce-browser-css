#==============================================================================================
#
#   dump_enums - the Enums.json part of the dump, and the sizes of the enums
#
#   DESCRIPTION:
#       One dump_enum call per enum of Enums.json (written out from Enums.json at Ladybird
#       47c82b38d0, as the C++ side of the dump is), and the number of values of the enums the
#       other parts walk.
#
#==============================================================================================

## The number of Keyword values, Invalid included.
let keyword_count: u64 = 850
## The number of PropertyID values, Custom included.
let property_count: u64 = 386
## The number of AtRuleID values.
let at_rule_count: u64 = 5
## The number of DescriptorID values before Custom.
let descriptor_count: u64 = 37

## Print, for an enum of Enums.json with `count` values: each value's keyword and string, then
## each keyword that converts to a value.
func dump_enum[E](out: Out*, name: str, count: u64, from_int: func(u64) -> E, to_int: func(E) -> u64,
        to_keyword: func(E) -> css_data.Keyword, to_string: func(E) -> ak.StringView,
        from_keyword: func(css_data.Keyword) -> E?) -> !:
    try out.p(f"enum {name} {count}\n")
    for value in 0..<count:
        let e = from_int(value)
        try out.p(f"{name} {value} kw={(u64)(u16)to_keyword(e)} str=")
        try out.view(to_string(e))
        try out.p("\n")
    for keyword in 0..<keyword_count:
        if let converted = from_keyword((css_data.Keyword)(u16)keyword):
            try out.p(f"{name} from {keyword} = {to_int(converted)}\n")

## The Enums.json part of the dump.
func dump_enums(out: Out*) -> !:
    try dump_enum[css_data.AbsoluteSize](out, "AbsoluteSize", 8, absolute_size_from_int, absolute_size_to_int,
        css_data.to_keyword_absolute_size, css_data.to_string_absolute_size, css_data.keyword_to_absolute_size)
    try dump_enum[css_data.AlignContent](out, "AlignContent", 10, align_content_from_int, align_content_to_int,
        css_data.to_keyword_align_content, css_data.to_string_align_content, css_data.keyword_to_align_content)
    try dump_enum[css_data.AlignItems](out, "AlignItems", 12, align_items_from_int, align_items_to_int,
